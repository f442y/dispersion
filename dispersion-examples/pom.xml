<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.github.f442y.dispersion</groupId>
        <artifactId>dispersion-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>dispersion-examples</artifactId>
    <packaging>jar</packaging>

    <name>Dispersion :: Examples</name>
    <description>Showcase and runnable examples illustrating Dispersion patterns and best practices</description>
    <url>https://github.com/f442y/dispersion</url>

    <dependencies>
        <!-- Internal Dispersion Modules -->
        <dependency>
            <groupId>com.github.f442y.dispersion</groupId>
            <artifactId>dispersion-event-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.f442y.dispersion</groupId>
            <artifactId>dispersion-fsm-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.f442y.dispersion</groupId>
            <artifactId>dispersion-orchestration-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.f442y.dispersion</groupId>
            <artifactId>dispersion-control-core</artifactId>
        </dependency>

        <!-- Logging Facade -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Testing Framework & Test Runtime Logger -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
