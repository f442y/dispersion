                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.f442y.dispersion</groupId>
                <artifactId>dispersion-fsm-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.f442y.dispersion</groupId>
                <artifactId>dispersion-orchestration-test</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.f442y.dispersion</groupId>
