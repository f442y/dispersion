    <artifactId>dispersion-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Dispersion :: Parent</name>
    <description>Ultra-high throughput, event-driven deterministic state machine and distributed orchestration framework</description>
    <url>https://github.com/f442y/dispersion</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>f442y</id>
            <name>Faizaan Ahmed</name>
            <url>https://github.com/f442y</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/f442y/dispersion.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/f442y/dispersion.git</developerConnection>
        <url>https://github.com/f442y/dispersion</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/f442y/dispersion/issues</url>
    </issueManagement>

    <modules>
        <module>bom</module>
        <module>event/api</module>
        <module>event/core</module>
        <module>event/test</module>
        <module>fsm/api</module>
        <module>fsm/core</module>
        <module>fsm/test</module>
        <module>orchestration/api</module>
        <module>orchestration/core</module>
        <module>orchestration/batch</module>
        <module>orchestration/messaging</module>
        <module>orchestration/test</module>
