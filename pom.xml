        <module>control-plane/core</module>
        <module>control-plane/test</module>
        <module>routing/api</module>
        <module>routing/core</module>
        <module>routing/test</module>
        <module>serialization/binary/api</module>
        <module>serialization/binary/fory</module>
        <module>serialization/json/api</module>
        <module>serialization/json/avaje</module>
        <module>server/api</module>
        <module>server/jakarta</module>
        <module>server/standalone</module>
        <module>testkit</module>
        <module>examples</module>
    </modules>

    <properties>
        <!-- Project Versioning & CI Friendly Resolution -->
        <revision>0.1.0${changelist}</revision>
        <changelist>-SNAPSHOT</changelist>

        <!-- Java Runtime & Encoding Constraints -->
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>
        <maven.compiler.proc>full</maven.compiler.proc>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Dependency Versions: Specifications & Annotations -->
        <jspecify.version>1.0.1</jspecify.version>

        <!-- Dependency Versions: Logging Subsystem -->
        <slf4j.version>2.0.20</slf4j.version>
        <logback.version>1.6.4</logback.version>

        <!-- Dependency Versions: Serialization Frameworks -->
        <avaje-jsonb.version>3.16</avaje-jsonb.version>
        <apache-fory.version>1.7.5</apache-fory.version>

        <!-- Dependency Versions: Server & Web Frameworks -->
        <jakarta-ws-rs.version>4.0.0</jakarta-ws-rs.version>
        <helidon.version>4.5.5</helidon.version>

        <!-- Dependency Versions: Testing Frameworks & Assertions -->
        <junit-jupiter.version>6.1.3</junit-jupiter.version>
        <assertj.version>3.27.7</assertj.version>

        <!-- Plugin Versions: Compilation & Testing -->
        <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>

        <!-- Plugin Versions: Packaging & Documentation -->
        <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>

        <!-- Plugin Versions: Quality, Verification & Environment -->
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <maven-failsafe-plugin.version>${maven-surefire-plugin.version}</maven-failsafe-plugin.version>

        <!-- Plugin Versions: Lifecycle & Deployment -->
        <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
        <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
        <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
        <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>

        <!-- Plugin Versions & Build Configuration Flags -->
        <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
        <flatten.skip>false</flatten.skip>
        <test.excludedGroups>LongRunningTests, Playground</test.excludedGroups>
        <dispersion.log.level>WARN</dispersion.log.level>
        <argLine>-XX:+EnableDynamicAgentLoading -Dfile.encoding=UTF-8 -Ddispersion.log.level=${dispersion.log.level}</argLine>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Dispersion Internal Modules -->
            <dependency>
                <groupId>com.github.f442y.dispersion</groupId>
