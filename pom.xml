                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.f442y.dispersion</groupId>
                <artifactId>dispersion-control-plane-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.f442y.dispersion</groupId>
