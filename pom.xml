            </dependency>
            <dependency>
                <groupId>com.github.f442y.dispersion</groupId>
                <artifactId>dispersion-routing-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.f442y.dispersion</groupId>
                <artifactId>dispersion-routing-test</artifactId>
