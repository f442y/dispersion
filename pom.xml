                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.f442y.dispersion</groupId>
                <artifactId>dispersion-fsm-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.f442y.dispersion</groupId>
